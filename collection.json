{
  "info": {
    "name": "Workflow Brain \u2014 Finaag & Lyntra",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set finaagReference and lyntraReference manually in collection variables. Run each folder in order. Change references manually to start new workflows."
  },
  "variable": [
    {
      "key": "brainBaseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "finaagReference",
      "value": "",
      "type": "string"
    },
    {
      "key": "lyntraReference",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set(\"requestId\", pm.variables.replaceIn(\"{{$guid}}\"));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Finaag workflow",
      "item": [
        {
          "name": "01 Create finaag",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{brainBaseUrl}}/api/workflows",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metadata\": {\n    \"operation\": \"CREATE\",\n    \"requestId\": \"{{requestId}}\",\n    \"referenceId\": \"{{finaagReference}}\",\n    \"workflowKey\": \"finaag\",\n    \"idempotencyKey\": \"{{finaagReference}}-create\"\n  },\n  \"payload\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Success\", () => pm.expect(pm.response.json().metadata.status).to.eql(\"SUCCESS\"));"
                ]
              }
            }
          ]
        },
